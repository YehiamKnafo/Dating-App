pipeline {
    agent {
        label 'yehiamE'
    }
    environment {
        // Define environment variables (can be loaded from Jenkins credentials)
        JAVA_DATING_APP_VERSION = "1.0.0-SNAPSHOT"
        GITHUB_TOKEN = credentials("GITHUB_TOKEN")
    }




    stages {
        // Stage 1: Checkout code from SCM (Git)

        stage('Checkout') {
            steps {
                checkout scm // Checkout code from the configured SCM (e.g., Git)
             
            }
            
        }
    
        //  Build the application using Gradle
        stage('Build') {
            steps {
                dir('Frontend') {
                    script {
                        // This calls the 'gradle' installed on your Windows OS
                        bat 'gradle clean build' 
                    }
                }
            }
        }
        stage('Adding Runtime') {
            steps {
                dir('Frontend'){
                    script {
                        
                        
                        bat 'gradle downloadJre' // Use 'sh' for Linux/macOS
                    
                    }
                }
            }
        }

        // Stage 3: Create EXE file
        stage('Create EXE') {
            steps {
                dir('Frontend'){
                    script {
                        
                        bat 'gradle createExe' // Use 'sh' for Linux/macOS
                    
                    }
                }
            }
        }

        // Stage 4: Create ZIP file
        stage('Create Zip') {
            steps {
                dir('Frontend'){
                    script {
                            bat 'gradle zipLaunch4j' // Use 'sh' for Linux/macOS
                    
                    }
                }
            }
        }

    

        

        // Stage 5: Publish GitHub Release
      stage('GitHub Release') {
        steps {
            withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                script {
                    dir('Frontend') {
                        bat "echo # Release v${env.JAVA_DATING_APP_VERSION} > release-notes.md"
                        bat "echo - Built automatically by Jenkins >> release-notes.md"
                        bat "echo - High performance Beta build >> release-notes.md"
                        // 1. Create the release
                        bat "gh release create v${env.JAVA_DATING_APP_VERSION} --title \"Release ${env.JAVA_DATING_APP_VERSION}\" --notes-file release-notes.md"
                        
                        // 2. Upload the asset (streams from disk, no OOM error!)
                        bat "gh release upload v${env.JAVA_DATING_APP_VERSION} build/distributions/DatingApp-${env.JAVA_DATING_APP_VERSION}.zip"
                    }
                }
            }
        }
}
        //    stage('Clean Workspace') {
        //     steps {
        //         script {
        //                 sh 'chmod +x gradlew'
        //                 sh './gradlew clean' // Use 'sh' for Linux/macOS
                
        //         }
        //     }
        // }

    }

    post {
        success {
            echo 'Pipeline succeeded! 🎉'
            // Notify the team
        }
        failure {
            echo 'Pipeline failed! 😢'
            // Notify the team
        }
        cleanup {
            script {
                // This safely deletes the workspace
                deleteDir()
            }
        }
    }

}